import random 
import math 
 
def print_board(board): 
    for i in range(0, 9, 3): 
        print(board[i:i+3]) 
    print() 
 
def check_winner(board): 
    win_states = [(0,1,2),(3,4,5),(6,7,8), 
                  (0,3,6),(1,4,7),(2,5,8), 
                  (0,4,8),(2,4,6)] 
     
    for a,b,c in win_states: 
        if board[a] == board[b] == board[c] and board[a] != ' ': 
            return board[a] 
    if ' ' not in board: 
        return 'Draw' 
    return None 
 
def available_moves(board): 
    return [i for i in range(9) if board[i] == ' '] 

 
class Node: 
    def __init__(self, board, player, parent=None): 
        self.board = board 
        self.player = player 
        self.parent = parent 
        self.children = [] 
        self.visits = 0 
        self.wins = 0 
        self.untried_moves = available_moves(board) 
 
 
def uct_value(parent_visits, node): 
    if node.visits == 0: 
        return float('inf')   
    return (node.wins / node.visits) + math.sqrt(2 * math.log(max(1, parent_visits)) / 
node.visits) 
 
def select(node): 
    while node.children: 
        node = max(node.children, key=lambda n: uct_value(node.visits, n)) 
    return node 
 
def expand(node): 
    if not node.untried_moves: 
        return node 
     
    move = node.untried_moves.pop() 
    new_board = node.board[:] 
    new_board[move] = node.player 
     
    child = Node(new_board, 'O' if node.player == 'X' else 'X', node) 
    node.children.append(child) 
    return child 
 
def simulate(node): 
    board = node.board[:] 
    player = node.player 
     
    while True: 
        winner = check_winner(board) 
        if winner: 
            return winner 
         
        move = random.choice(available_moves(board)) 
        board[move] = player 
        player = 'O' if player == 'X' else 'X' 
 
def backpropagate(node, result): 
    while node: 
        node.visits += 1 
        if node.player != result: 
            node.wins += 1 
        node = node.parent 
 
def mcts(root, iterations=500): 
    for _ in range(iterations): 
        node = select(root) 
         
        if not check_winner(node.board): 
            node = expand(node) 
         
        result = simulate(node) 
        backpropagate(node, result) 
     
    return max(root.children, key=lambda n: n.visits).board 
 
 
def minimax(board, is_max, alpha, beta): 
    winner = check_winner(board) 
    if winner == 'X': return 1 
    if winner == 'O': return -1 
    if winner == 'Draw': return 0 
 
    if is_max: 
        best = -math.inf 
        for move in available_moves(board): 
            board[move] = 'X' 
            val = minimax(board, False, alpha, beta) 
            board[move] = ' ' 
            best = max(best, val) 
            alpha = max(alpha, best) 
            if beta <= alpha: break 
        return best 
    else: 
        best = math.inf 
        for move in available_moves(board): 
            board[move] = 'O' 
            val = minimax(board, True, alpha, beta) 
            board[move] = ' ' 
            best = min(best, val) 
            beta = min(beta, best) 
            if beta <= alpha: break 
        return best 
 
def best_move_minimax(board): 
    best_val = -math.inf 
    move_choice = None 
    for move in available_moves(board): 
        board[move] = 'X' 
        move_val = minimax(board, False, -math.inf, math.inf) 
        board[move] = ' ' 
        if move_val > best_val: 
            best_val = move_val 
            move_choice = move 
    return move_choice 
 
 
board = [' '] * 9 
 
print("Initial Board:") 
print_board(board) 
 
root = Node(board, 'X') 
new_board = mcts(root, iterations=500) 
print("MCTS Move:") 
print_board(new_board) 
move = best_move_minimax(board) 
board[move] = 'X' 
print("Minimax Move:") 
print_board(board) 
