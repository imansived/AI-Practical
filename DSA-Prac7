#include <iostream> 
using namespace std; 
 
const int SIZE = 10; 
 
struct Employee { 
    int id; 
    string name; 
    bool occupied = false; 
}; 
 
Employee table[SIZE]; 
 
// Hash function 
int hashFunction(int key) { 
    return key % SIZE; 
} 
 
// Insert employee 
void insert(int id, string name) { 
    int index = hashFunction(id); 
 
    // Linear probing 
    while (table[index].occupied) { 
        index = (index + 1) % SIZE; 
    } 
 
    table[index].id = id; 
    table[index].name = name; 
    table[index].occupied = true; 
 
    cout << "Employee inserted!\n"; 
} 
 
// Search employee 
void search(int id) { 
    int index = hashFunction(id); 
    int start = index; 
 
    while (table[index].occupied) { 
        if (table[index].id == id) { 
            cout << "Found: ID = " << table[index].id  
                 << ", Name = " << table[index].name << endl; 
            return; 
        } 
        index = (index + 1) % SIZE; 
 
        if (index == start) break; // full loop 
    } 
 
    cout << "Employee not found!\n"; 
} 
 
// Display table 
void display() { 
    cout << "\nHash Table:\n"; 
    for (int i = 0; i < SIZE; i++) { 
        if (table[i].occupied) 
            cout << i << " -> " << table[i].id << ", " << table[i].name << endl; 
        else 
            cout << i << " -> Empty\n"; 
    } 
} 
 
int main() { 
    int choice, id; 
    string name; 
 
    do { 
        cout << "\n1. Insert\n2. Search\n3. Display\n4. Exit\n"; 
        cout << "Enter choice: "; 
        cin >> choice; 
 
        switch (choice) { 
        case 1: 
            cout << "Enter ID and Name: "; 
            cin >> id >> name; 
            insert(id, name); 
            break; 
 
        case 2: 
            cout << "Enter ID to search: "; 
            cin >> id; 
            search(id); 
            break; 
 
case 3: 
display(); 
break; 
} 
} while (choice != 4); 
return 0; 
} 
