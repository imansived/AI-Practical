#include<iostream> 
using namespace std; 
struct Node 
{ 
    string name; 
    Node *left; 
    Node *right; 
}; 
Node* createNode(string n) 
{ Node *nn = new Node(); 
    nn->name = n; 
    nn->left = NULL; 
    nn->right = NULL; 
    return nn; 
} 
Node* buildTree() 
{ 
    string val; 
    cout << "Enter node value (or NULL for no node): "; 
    cin >> val; 
 
    if(val == "NULL") 
        return NULL; 
    Node* root = createNode(val); 
    cout << "Enter left child of " << val << endl; 
    root->left = buildTree(); 
    cout << "Enter right child of " << val << endl; 
    root->right = buildTree(); 
return root; 
} 
void Display_Tree(Node *root, int level = 0, string rel = "root") 
{ 
    if(root == NULL) 
        return; 
    for(int i = 0; i < level; i++) 
        cout << "   "; 
    cout << rel << ": " << root->name << endl; 
    Display_Tree(root->left, level + 1, "left"); 
    Display_Tree(root->right, level + 1, "right"); 
} 
void inorder(Node* root) 
{ 
    if(root != NULL) 
    { 
        inorder(root->left); 
        cout << root->name << " "; 
        inorder(root->right); 
    } 
} 
void preorder(Node* root) 
{ 
    if(root != NULL) 
    { 
        cout << root->name << " "; 
        preorder(root->left); 
        preorder(root->right); 
    } 
} 
void postorder(Node* root) 
{ 
    if(root != NULL) 
    { 
        postorder(root->left); 
        postorder(root->right); 
        cout << root->name << " "; 
    }} 
int main() 
{   Node *root = NULL; 
    cout << "Build your tree:\n"; 
    root = buildTree(); 
    Display_Tree(root); 
    cout << "\nInorder Traversal: "; 
    inorder(root); 
    cout << "\nPreorder Traversal: "; 
    preorder(root); 
    cout << "\nPostorder Traversal: "; 
    postorder(root); 
    return 0; 
} 
