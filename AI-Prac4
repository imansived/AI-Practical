# Backtracking  
def is_safe(board, row, col): 
    for i in range(row): 
        if board[i] == col or abs(board[i] - col) == abs(i - row): 
            return False 
    return True 
 
 
def solve_backtracking(n): 
    board = [-1] * n 
 
    def backtrack(row): 
        if row == n: 
            print("BT Solution:", board) 
            return 
         
        for col in range(n): 
            if is_safe(board, row, col): 
                board[row] = col 
                backtrack(row + 1) 
                board[row] = -1 
 
    backtrack(0) 
 
 
#Branch & Bound  
def solve_branch_bound(n): 
    board = [-1] * n 
 
    cols = [False] * n 
    diag1 = [False] * (2 * n)    
    diag2 = [False] * (2 * n)    
 
    def solve(row): 
        if row == n: 
            print("BB Solution:", board) 
            return 
         
        for col in range(n): 
            if not cols[col] and not diag1[row + col] and not diag2[row - col + n]: 
                 
                board[row] = col 
                cols[col] = diag1[row + col] = diag2[row - col + n] = True 
                 
                solve(row + 1) 
                 
                board[row] = -1 
                cols[col] = diag1[row + col] = diag2[row - col + n] = False 
 
    solve(0) 
 
 
n = 4 
print("Backtracking Solutions:") 
solve_backtracking(n) 
print("\nBranch & Bound Solutions:") 
solve_branch_bound(n)
