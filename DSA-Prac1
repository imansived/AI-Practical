#include <iostream> 
#include <string> 
using namespace std; 
 
int fibonacciSearch(string arr[], int n, string x) 
{ 
    
    int fibMm2 = 0;    
    int fibMm1 = 1;   
    int fibM = fibMm1 + fibMm2;   
    while (fibM < n) 
    { 
        fibMm2 = fibMm1; 
        fibMm1 = fibM; 
        fibM = fibMm1 + fibMm2; 
    } 
 
    int offset = -1; 
 
    while (fibM > 1) 
    { 
        int i = min(offset + fibMm2, n - 1); 
 
        if (arr[i] == x) 
            return i; 
 
        if (arr[i] < x) 
        { 
            fibM = fibMm1; 
            fibMm1 = fibMm2; 
            fibMm2 = fibM - fibMm1; 
            offset = i; 
        } 
 
        else 
        { 
            fibM = fibMm2; 
            fibMm1 = fibMm1 - fibMm2; 
            fibMm2 = fibM - fibMm1; 
        } 
    } 
 
    if (fibMm1 && arr[offset + 1] == x) 
        return offset + 1; 
 
    return -1; 
} 
 
int main() 
{ 
    int n; 
 
    cout << "Enter number of books: "; 
    cin >> n; 
 
    string books[n]; 
 
    cout << "Enter book titles in alphabetical order:\n"; 
    for (int i = 0; i < n; i++) 
    { 
        cin >> books[i]; 
    } 
 
    string target; 
    cout << "Enter book to search: "; 
    cin >> target; 
 
    int result = fibonacciSearch(books, n, target); 
 
    if (result != -1) 
        cout << "Book found at position: " << result + 1 << endl; 
    else 
        cout << "Book not found" << endl; 
 
    return 0;
}
